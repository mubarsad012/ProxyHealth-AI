# ProxyHealth AI API — LOCAL AI preset (docs/LOCAL_AI.md; docs/research/free-ai-providers.md §4.2–§4.5).
# scripts/use-local-ai.sh copies this file to apps/api/.env (it backs up an existing .env first and
# refuses to overwrite one without --force). .env is git-ignored; this preset holds no secrets.
#
# What it does: the API sends papers to an open-weight model (Qwen3.5-4B) served by Ollama on THIS
# Mac at 127.0.0.1:11434. Nothing goes to an outside AI company. Data-use tier "local": real papers
# are allowed, in development and staging only. The server refuses to boot with tier "local" when the
# base URL is not a loopback address (127.0.0.0/8, ::1, localhost) and always refuses it when
# ENV=production (research §4.2 boot rules 1 and 4).
#
# Before using it: install Ollama and pull the model with `make local-ai-setup` (it asks before every
# download), then check the whole pipeline on a SAMPLE paper with `make local-ai-check`.
# Switch back: `scripts/use-local-ai.sh --restore` (your previous .env) or `scripts/use-local-ai.sh --off`
# (no .env at all = AI_PROVIDER=mock, zero keys).

ENV=development
AI_PROVIDER=openai_compat

# Ollama's OpenAI-compatible endpoint (research §3.5). Leave the host on loopback: the phone talks to
# the ProxyHealth API, never to Ollama.
OPENAI_COMPAT_BASE_URL=http://127.0.0.1:11434/v1
# Ollama requires a bearer token on /v1 but ignores its value. Not a secret.
OPENAI_COMPAT_API_KEY=ollama

# One model for both tiers: two local models would double RAM and disk (research §4.2, §4.5).
# Always type the size tag: qwen3.5:latest is the 9B (6.6 GB). Never a :cloud / -cloud tag (those send
# prompts to Ollama's servers), and never the bare qwen3-vl:8b / qwen3-vl:latest (the thinking build).
OPENAI_COMPAT_MODEL_PRO=qwen3.5:4b
OPENAI_COMPAT_MODEL_FAST=qwen3.5:4b

# local = the model runs on this machine (loopback only, boot-checked).
OPENAI_COMPAT_DATA_TIER=local
# Shown in the consent copy as {model} ("Your photo is read by Qwen, an AI program that runs on our
# server."). Required for the local tier.
OPENAI_COMPAT_MODEL_LABEL=Qwen

# Structured output (research §4.4): Ollama /v1 takes response_format json_schema. Every mode still goes
# through Pydantic validation + one repair retry + the two_call fallback. If a spike shows the schema
# mode failing with images, try json_object, then prompt.
OPENAI_COMPAT_JSON_MODE=json_schema
# Thinking (research §4.5): Qwen3.5 thinks by default, which multiplies local latency; "none" sends
# reasoning_effort "none" on every call. "mapped" maps the task's ThinkingLevel to low/medium/high.
OPENAI_COMPAT_REASONING=none

# Time limits (research §4.2 rule 5, §4.6): a 4B model on a fanless M4 needs about 1–4 minutes per
# paper. FAILOVER_DEADLINE_S must be at least OPENAI_COMPAT_TIMEOUT_S + 10.
OPENAI_COMPAT_TIMEOUT_S=300
FAILOVER_DEADLINE_S=310

# Optional, shown with their defaults (research §4.2). Uncomment only to change them.
# OPENAI_COMPAT_MAX_OUTPUT_TOKENS=6144   # cap on top of AI_PROMPTS §3 (16384 is too slow locally)
# OPENAI_COMPAT_MAX_IMAGES=12            # pages per request sent to the model
# OPENAI_COMPAT_CONCURRENCY=1            # loopback default 1: two parallel calls fight for 16 GB of RAM
