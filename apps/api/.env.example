# ProxyHealth AI API — environment (ARCHITECTURE §6.1). Copy to apps/api/.env; .env is git-ignored.
# Secrets live only in .env (or the host's secret manager), never in the repo or the mobile app.
#
# The whole app runs with ZERO keys: AI_PROVIDER=mock serves the sample papers (data use tier "demo").
#
# Data-use tier (D-01), computed from the per-key "billing" flags below:
#   paid   = every slot billing:true  -> real documents allowed
#   unpaid = every slot billing:false -> real documents BLOCKED (403); sample papers only
#   mixed  = some of each             -> reported "mixed", routed and gated as unpaid
#   demo   = AI_PROVIDER=mock;  none = AI_PROVIDER=gemini with no slots (boots only in development)
#   local / attested / unpaid = AI_PROVIDER=openai_compat with OPENAI_COMPAT_DATA_TIER (see the
#   openai_compat block at the end; docs/research/free-ai-providers.md §4, §5).
# Why: under the Gemini API terms, prompts and responses sent through unpaid quota may be used to
# improve Google products and read by human reviewers; Google says not to send sensitive or
# personal information there. A key is "paid" only when its Cloud project has an active billing
# account. The server cannot detect billing, so "billing" is YOUR attestation.
#
# Region rule (D-03): if any users are in the EEA, Switzerland or the UK, every key must be
# billing:true and ALLOW_UNPAID_KEYS must be unset. v1 is US-only and does not geolocate users.

AI_PROVIDER=mock

# ENV=development                      # development | staging | production (production refuses billing:false slots unless ALLOW_UNPAID_KEYS=1, and always refuses ALLOW_UNPAID_REAL_DOCUMENTS)
# AI_PROVIDER=mock                     # mock | gemini | openai_compat | gemini_interactions (LATER, refused at boot)
# GEMINI_KEYS=[]                       # JSON list of {"key","project","billing"}; each key from a DIFFERENT Google Cloud project
#                                      # (rate limits are per project; duplicate "project" labels abort boot).
#                                      # "billing": true is an operator attestation that a Cloud Billing account is attached.
#                                      # Example: [{"key":"AIza...","project":"proxyhealth-prod-a","billing":true},{"key":"AIza...","project":"proxyhealth-prod-b","billing":true}]
# ALLOW_UNPAID_KEYS=0                  # let production boot with billing:false slots (sample papers only; real documents stay blocked)
# ALLOW_UNPAID_REAL_DOCUMENTS=false    # dev-only bypass of the 403 gate for synthetic test scans; boot error in production
# MODEL_PRO=gemini-3.8-flash           # reasoning tier; gemini-1.5/2.0/2.5 and *-latest are refused at boot (D-04)
# MODEL_FAST=gemini-3.5-flash-lite     # fast tier (language packs, chat, tagging, rewrites)
# MODEL_PRO_DEGRADED_THINKING=medium   # thinking level when a pro task runs on the fast model
# ALLOW_DEGRADED=true                  # enable pro -> fast degradation when every pro slot is cooling
# ANALYSIS_MODE=auto                   # auto | single | two_call (D-06)
# TRANSLATE_FULL_MAX_PAGES=4           # full translation only up to this many pages
# RPD_SOFT_CAP_PRO=0                   # per-slot daily soft caps; 0 = disabled. Set after reading AI Studio limits.
# RPD_SOFT_CAP_FAST=0
# UPSTREAM_TIMEOUT_S=90                # per upstream call (seconds)
# FAILOVER_DEADLINE_S=100              # total budget per request across slots (seconds)
# MAX_PAGES=12                         # images per request
# MAX_PAGE_BYTES=4194304               # per image (decoded)
# MAX_PDF_BYTES=12582912               # per PDF (decoded)
# MAX_PDF_PAGES=60
# MAX_REQUEST_BYTES=20971520           # JSON body; larger bodies get 413 before parsing
# MAX_UPSTREAM_INLINE_BYTES=18874368   # sum of media bytes sent to Gemini
# MAX_CHAT_HISTORY=8
# CORS_ORIGINS=http://localhost:8081   # comma list; add the web host (e.g. https://proxyhealth.expo.app)
# APP_TOKEN=                           # when set, X-App-Token is required on every request (401 otherwise)
# ADMIN_TOKEN=                         # enables GET /v1/admin/keys with X-Admin-Token (404 while unset)
# INSTALL_HASH_SECRET=                 # HMAC secret for install-id hashing (random per process when unset; set it in production)
# RATE_LIMIT_ANALYZE_PER_HOUR=20       # per install hash (analyze, troubleshoot, chat, language-pack generation)
# RATE_LIMIT_ANALYZE_PER_DAY=100
# RATE_LIMIT_IP_PER_MINUTE=60          # coarse per-IP-class (/24, /48) bucket; applies to EVERY model-calling request, install id or not (D-08)
# RATE_LIMIT_IP_PER_DAY=1000           # daily cap per IP class on the same routes (a rotated X-Install-Id never escapes it)
# TRUSTED_PROXY_HOPS=0                 # proxies that append to X-Forwarded-For (Cloud Run: 1, behind an external HTTPS LB: 2; the Dockerfile sets 1); 0 = socket peer
# CONSENT_VERSION=2026-10-04           # echoed in /v1/config; bump when consent copy changes (clients re-consent)
# PRIVACY_POLICY_URL=https://proxyhealth.expo.app/privacy
# VAR_DIR=./var                        # runtime state (git-ignored): keypool.json, langpacks/, feedback_counts.sqlite — never user content
# LANGPACK_CACHE_TTL_DAYS=180          # generated language packs older than this are pruned
# MOCK_LATENCY_MIN_MS=300              # mock provider simulated latency
# MOCK_LATENCY_MAX_MS=900
# MOCK_PHASH_MAX_HAMMING=10            # dHash threshold for recognising a photographed sample paper
# RECORD_FIXTURES=false                # dev only (WP7 recording provider, D-16): capture live model output into fixtures
# LOG_LEVEL=info                       # debug | info | warning | error | critical (logs are content-free either way)
# RUN_LIVE=0                           # enables tests/live (needs billed keys)

# --- AI_PROVIDER=openai_compat: any OpenAI-compatible /chat/completions endpoint (free-ai-providers §4)
# For testing with your OWN papers without paying: run an open-weight vision model on this machine
# (Ollama or LM Studio) and use OPENAI_COMPAT_DATA_TIER=local — the paper never leaves the machine
# that runs this API. Hosted free endpoints are for SAMPLE papers only (tier unpaid), unless you set
# up the development-only "attested" tier. ENV=production refuses AI_PROVIDER=openai_compat.
# Before relying on "our server does not keep it" on the local tier, run the Ollama on-disk check
# (free-ai-providers §4.9). Ollama's OpenAI endpoint cannot set the context per request: set
# OLLAMA_CONTEXT_LENGTH=16384 on the Ollama side first (§3.3). Check a setup with
# apps/api/.venv/bin/python apps/api/scripts/provider_check.py (sample papers; nothing is written).
#
# AI_PROVIDER=openai_compat
# OPENAI_COMPAT_BASE_URL=http://127.0.0.1:11434/v1   # Ollama; LM Studio: http://127.0.0.1:1234/v1
# OPENAI_COMPAT_API_KEY=                     # hosted endpoints need one (boot error otherwise); Ollama ignores it
# OPENAI_COMPAT_MODEL_PRO=qwen3.5:4b         # model ids come only from these two variables
# OPENAI_COMPAT_MODEL_FAST=qwen3.5:4b        # same model locally (two models would double RAM and disk)
# OPENAI_COMPAT_DATA_TIER=unpaid             # local | attested | unpaid (default)
#     local    = loopback base URL only (127.0.0.0/8, ::1, localhost; boot error otherwise), needs
#                OPENAI_COMPAT_MODEL_LABEL, refuses Ollama ":cloud"/"-cloud" models -> real papers allowed
#     attested = ENV=development only; needs OPENAI_COMPAT_VENDOR_NAME, OPENAI_COMPAT_NO_TRAINING_ATTESTED=1
#                and a host off the denylist (*.cn, *.deepseek.com, *.moonshot.*, *.kimi.ai, *.minimax.io,
#                *.stepfun.ai, integrate.api.nvidia.com, generativelanguage.googleapis.com) -> your own papers
#     unpaid   = needs OPENAI_COMPAT_VENDOR_NAME; real papers 403, sample papers only (like Gemini unpaid)
# OPENAI_COMPAT_MODEL_LABEL=Qwen             # shown in the consent copy as {model}; required for local
# OPENAI_COMPAT_VENDOR_NAME=                 # shown as {vendor} (e.g. "Groq"); required for attested and unpaid
# OPENAI_COMPAT_NO_TRAINING_ATTESTED=0       # YOUR statement that the vendor's API terms say no training on API content
# OPENAI_COMPAT_JSON_MODE=auto               # auto (host table, falls back to prompt on a schema 400) | json_schema | json_object | prompt
# OPENAI_COMPAT_REASONING=none               # none (send reasoning_effort "none") | mapped (thinking level -> effort) | omit
# OPENAI_COMPAT_TIMEOUT_S=                   # per call incl. its one repair retry; default 300 on loopback, 90 otherwise
# OPENAI_COMPAT_MAX_OUTPUT_TOKENS=           # cap on top of each task's own limit; default 4096 on loopback, 6144 otherwise (16384 is too slow locally)
# OPENAI_COMPAT_MAX_IMAGES=                  # pages per call; default 2 on loopback, 12 otherwise (Groq free: 3; Cerebras free: 2); PDFs are rasterised
# OPENAI_COMPAT_CONCURRENCY=                 # parallel calls; default 1 on loopback (16 GB RAM), 4 otherwise
# FAILOVER_DEADLINE_S must be >= OPENAI_COMPAT_TIMEOUT_S + 10 (left unset, it is raised to that value).
# /v1/config then tells the app to wait FAILOVER_DEADLINE_S + OPENAI_COMPAT_TIMEOUT_S + 15 s per model call.
