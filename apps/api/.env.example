# ProxyHealth AI API — environment (ARCHITECTURE §6.1). Copy to apps/api/.env; .env is git-ignored.
# The whole app runs with ZERO keys: AI_PROVIDER=mock serves fixtures only.

AI_PROVIDER=mock

# ENV=development                      # development | staging | production (production forbids unbilled keys and ALLOW_UNPAID_REAL_DOCUMENTS)
# AI_PROVIDER=mock                     # mock | gemini | gemini_interactions (LATER)
# GEMINI_KEYS=[]                       # JSON list of {"key","project","billing"}; one key per distinct Google Cloud project.
#                                      # "billing" is an operator attestation that a Cloud Billing account is attached (paid tier, D-01).
#                                      # Example: [{"key":"AIza...","project":"proxyhealth-prod-a","billing":true}]
# ALLOW_UNPAID_KEYS=0                  # let production boot with billing:false slots (fixtures only)
# ALLOW_UNPAID_REAL_DOCUMENTS=false    # dev-only bypass of the 403 gate for synthetic scans; boot error in production
# MODEL_PRO=gemini-3.8-flash           # reasoning tier; gemini-1.5/2.0/2.5 and -latest are refused (D-04)
# MODEL_FAST=gemini-3.5-flash-lite     # fast tier
# MODEL_PRO_DEGRADED_THINKING=medium   # thinking level when a pro task runs on the fast model
# ALLOW_DEGRADED=true                  # enable pro → fast degradation
# ANALYSIS_MODE=auto                   # auto | single | two_call (D-06)
# TRANSLATE_FULL_MAX_PAGES=4           # full translation only up to this many pages
# RPD_SOFT_CAP_PRO=0                   # per-slot daily soft caps; 0 = disabled
# RPD_SOFT_CAP_FAST=0
# UPSTREAM_TIMEOUT_S=90                # per upstream call
# FAILOVER_DEADLINE_S=100              # total budget per request across slots
# MAX_PAGES=12                         # images per request
# MAX_PAGE_BYTES=4194304               # per image (decoded)
# MAX_PDF_BYTES=12582912               # per PDF (decoded)
# MAX_PDF_PAGES=60
# MAX_REQUEST_BYTES=20971520           # JSON body
# MAX_UPSTREAM_INLINE_BYTES=18874368   # sum of media bytes sent to Gemini
# MAX_CHAT_HISTORY=8
# CORS_ORIGINS=http://localhost:8081   # comma list; add the web host
# APP_TOKEN=                           # when set, X-App-Token is required (401 otherwise)
# ADMIN_TOKEN=                         # enables /v1/admin/keys (404 while unset)
# INSTALL_HASH_SECRET=                 # HMAC secret for install-id hashing (random per process in dev)
# RATE_LIMIT_ANALYZE_PER_HOUR=20       # per install hash
# RATE_LIMIT_ANALYZE_PER_DAY=100
# RATE_LIMIT_IP_PER_MINUTE=60          # coarse per-IP-class
# CONSENT_VERSION=2026-09-24           # echoed in /v1/config; bump when consent copy changes
# PRIVACY_POLICY_URL=https://proxyhealth.expo.app/privacy
# VAR_DIR=./var                        # runtime state dir (git-ignored): keypool.json, langpacks/, feedback_counts.sqlite
# LANGPACK_CACHE_TTL_DAYS=180
# MOCK_LATENCY_MIN_MS=300              # mock provider simulated latency
# MOCK_LATENCY_MAX_MS=900
# MOCK_PHASH_MAX_HAMMING=10            # dHash threshold
# LOG_LEVEL=info
# RUN_LIVE=0                           # enables live tests
